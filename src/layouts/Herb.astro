---
// The herbarium shell: Fay's top bar, type, shared stylesheet and wandering white
// butterfly. KIAZAKI supplies the name, the 33:27 mark, the nav and the foot.
import '../styles/herbarium.css';
import { profile } from '../data/profile';
import { url } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  /** Path of this page relative to the root, used for the active nav item. */
  path?: string;
  /** The home page: no name or section links in the bar (the page carries them). */
  home?: boolean;
  /** Extra scripts (paths under public/) to run after the shared ones. */
  scripts?: string[];
  noindex?: boolean;
}
const {
  title,
  description = profile.description,
  path = '',
  home = false,
  scripts = [],
  noindex = false,
} = Astro.props;
const fullTitle = title ? `${title} · ${profile.name}` : `${profile.name} · ${profile.mark} · ${profile.frequency}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const here = Astro.url.pathname;
const on = (p: string) => here.startsWith(url(p));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <!-- set the saved theme before the stylesheet paints, so there is no flash -->
  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem('hb-theme');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    })();
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  <meta name="theme-color" content="#0b0c0e" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Serif:ital,wght@0,400;0,500;1,400&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
  <script is:inline>document.documentElement.classList.add('hb-js');</script>
  <slot name="head" />
</head>
<body class={home ? 'is-home' : 'is-page'}>
  <a class="hb-skip" href="#main">Skip to content</a>
  <header class="hb-top">
    {!home && (
      <a class="hb-brand" href={url()} data-perch>
        <img class="hb-brand-owl" src={url('owl-mark.svg')} alt="" width="20" height="20" aria-hidden="true" />
        {profile.name}<span class="kz-mark" aria-hidden="true">{profile.mark}</span>
      </a>
    )}
    {!home && (
      <nav class="hb-nav" aria-label="Main">
        <a href={url('vault/')} aria-current={on('vault/') ? 'page' : undefined}>The Vault</a>
        <a href={url('imaginos/')} aria-current={on('imaginos/') ? 'page' : undefined}>Imaginos</a>
        <a href={url('logbook/')} aria-current={on('logbook/') ? 'page' : undefined}>Logbook</a>
      </nav>
    )}
    <span class="hb-chips">
      <button class="hb-theme" id="hb-theme" type="button" aria-label="Switch to the light sheet" aria-pressed="false">
        <svg class="hb-theme-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" />
        </svg>
        <svg class="hb-theme-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z" />
        </svg>
      </button>
      <span class="hb-chip" title="the frequency"><b>{profile.frequency}</b> · {profile.mark}</span>
    </span>
  </header>

  {home ? <slot /> : (
    <main class="hb hb-page" id="main">
      <slot />
      <footer class="hb-foot">
        <div class="hb-foot-main">
          <p class="hb-tag">{profile.frequency} · {profile.mark}</p>
          <a class="hb-mail" href={url('logbook/')} data-perch>Read the logbook</a>
          <p class="hb-foot-note">{profile.footer}</p>
          <p class="hb-readout">{profile.readout}</p>
        </div>
        <div class="hb-foot-side">
          <p class="hb-cta">
            <a href={url('vault/')}>The Vault ↗</a>
            <a href={url('imaginos/')}>Imaginos ↗</a>
            <a href={url('logbook/')}>Logbook ↗</a>
          </p>
        </div>
      </footer>
    </main>
  )}

  <!-- The white butterfly: wanders the page, perches on the work, opens the castle when caught -->
  <a class="hb-fly" id="hb-fly" href={url('castle/')} aria-label="Enter the castle">
    <canvas></canvas><span class="hb-fly-tip">Enter the castle</span>
  </a>

  {['js/flyer.js', 'experiments/kit.js', 'js/herb.js', ...scripts].map((s) => <script is:inline src={url(s)}></script>)}
  <script is:inline>
    (function () {
      var btn = document.getElementById('hb-theme');
      if (!btn) return;
      var root = document.documentElement;
      var meta = document.querySelector('meta[name="theme-color"]');
      function sync() {
        var light = root.getAttribute('data-theme') === 'light';
        btn.setAttribute('aria-pressed', String(light));
        btn.setAttribute('aria-label', light ? 'Switch to the night garden' : 'Switch to the light sheet');
        if (meta) meta.setAttribute('content', light ? '#f5f2e9' : '#0b0c0e');
      }
      btn.addEventListener('click', function () {
        var next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('hb-theme', next); } catch (e) {}
        sync();
      });
      sync();
    })();
  </script>
</body>
</html>
